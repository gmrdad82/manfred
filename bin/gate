#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CARGO_NET_GIT_FETCH_WITH_CLI=true
usage() {
  echo "usage: bin/gate [--fast | --public [lint | test | release]]" >&2
  exit 2
}
fast=0
public=0
phase=all
case "${1:-}" in
  --fast) fast=1; [ $# -le 1 ] || usage ;;
  --public)
    public=1
    case "${2:-all}" in
      all|lint|test|release) phase=${2:-all} ;;
      *) usage ;;
    esac
    [ $# -le 2 ] || usage
    ;;
  "") ;;
  *) usage ;;
esac
if [ "$public" = 1 ]; then
  if [ "$phase" = all ] || [ "$phase" = lint ]; then
    [ "$(uname -s)" != Linux ] || shellcheck bin/*
    cargo fmt --all --check
    cargo clippy --workspace --all-targets -- -D warnings
  fi
  if [ "$phase" = all ] || [ "$phase" = test ]; then
    cargo test --workspace --all-targets
    cargo test --workspace --doc
  fi
  if [ "$phase" = all ] || [ "$phase" = release ]; then
    cargo build --release
  fi
  exit 0
fi
shellcheck bin/*
for script in dev/wave.sh dev/watch.sh; do
  [ ! -f "$script" ] || shellcheck -S warning "$script"
done
cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
if [ "$fast" = 1 ]; then
  base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD)
  changed=$({ git diff --name-only "$base"; git diff --name-only --cached; git ls-files --others --exclude-standard; } | sort -u)
  packages=()
  whole=0
  while IFS= read -r path; do
    case "$path" in
      crates/*/*) packages+=("-p" "manfred-$(cut -d/ -f2 <<<"$path")") ;;
      src/*|tests/*|examples/*|showcase/*|Cargo.toml|Cargo.lock|build.rs) whole=1 ;;
    esac
  done <<<"$changed"
  if [ "$whole" = 1 ]; then
    cargo nextest run --workspace --no-tests=pass
  elif [ "${#packages[@]}" -gt 0 ]; then
    mapfile -t packages < <(printf '%s\n' "${packages[@]}" | paste -d' ' - - | sort -u | tr ' ' '\n')
    cargo nextest run "${packages[@]}" --no-tests=pass
  fi
  exit 0
fi
cargo nextest run --workspace --no-tests=pass
cargo test --workspace --doc
cargo build --release
